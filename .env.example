# ── Supabase ─────────────────────────────────────────────────────────────
# Project URL + keys from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only. Bypasses RLS — used by API routes after explicit role checks.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── First-run (optional) ─────────────────────────────────────────────────
# Pre-fills the Admin account on the /setup page for a fresh install.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── AI Assistant (server-side only, never exposed to the browser) ────────
# Any OpenAI-compatible chat-completions API with tool calling.
# Examples: https://api.openai.com/v1 (gpt-4o-mini) · https://api.groq.com/openai/v1 (llama-3.3-70b-versatile)
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-3.8-flash

# ── Designed system emails (optional) ────────────────────────────────────
# Without these, emails are still designed + stored in the admin Emails
# outbox. With a free https://resend.com key they are actually delivered.
RESEND_API_KEY=
EMAIL_FROM="HCM Lite <hr@yourdomain.com>"
